<Page x:Class="password_manager.GroupDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:password_manager"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GroupDetailsPage">

    <Grid>
        <ListView x:Name="GroupPasswordsList" Margin="10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Website" DisplayMemberBinding="{Binding Website}" Width="150"/>
                    <GridViewColumn Header="Username" DisplayMemberBinding="{Binding Username}" Width="150"/>
                    <GridViewColumn Header="Password" DisplayMemberBinding="{Binding PasswordMasked}" Width="150"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>
