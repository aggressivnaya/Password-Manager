<Page x:Class="password_manager.GroupPasswordsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:password_manager"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GroupPasswordsPage">

    <Page.Resources>
        <!-- Gradient Brushes -->
        <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF1a1a2e" Offset="0"/>
            <GradientStop Color="#FF16213e" Offset="1"/>
        </LinearGradientBrush>

        <!-- ListBox Item Style -->
        <Style x:Key="PasswordListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="#FF2a2a4a"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="8">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Style -->
        <Style x:Key="IconButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFaaaaaa"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource BackgroundGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="20,20,20,10">
            <Button Content="←" 
                    FontSize="20" 
                    Style="{StaticResource IconButton}"
                    Click="BackButton_Click"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0"/>
            <TextBlock x:Name="GroupNameTextBlock" 
                       Text="Work Team Passwords" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="White"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Search Bar -->
        <Grid Grid.Row="1" Margin="20,0,20,20">
            <TextBox x:Name="SearchBox"
                     Background="#FF2a2a4a"
                     Foreground="White"
                     BorderThickness="0"
                     Padding="10"
                     FontSize="14">
                <TextBox.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
            <TextBlock IsHitTestVisible="False"
                       Text="🔍 Search passwords..."
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="10,0,0,0"
                       Foreground="#FF6a6a8a">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Password List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,0,20,20">
                <ListBox Background="Transparent" 
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource PasswordListBoxItem}">
                    <ListBoxItem>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🌐" FontSize="20" Grid.Column="0" Margin="0,0,15,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Company Website" FontWeight="Bold"/>
                                <TextBlock Text="admin@company.com" Foreground="#FFaaaaaa"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="👁" Style="{StaticResource IconButton}" Margin="0,0,10,0"/>
                                <Button Content="📋" Style="{StaticResource IconButton}"/>
                            </StackPanel>
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="💼" FontSize="20" Grid.Column="0" Margin="0,0,15,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Project Management Tool" FontWeight="Bold"/>
                                <TextBlock Text="team@company.com" Foreground="#FFaaaaaa"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="👁" Style="{StaticResource IconButton}" Margin="0,0,10,0"/>
                                <Button Content="📋" Style="{StaticResource IconButton}"/>
                            </StackPanel>
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📊" FontSize="20" Grid.Column="0" Margin="0,0,15,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Analytics Dashboard" FontWeight="Bold"/>
                                <TextBlock Text="analytics@company.com" Foreground="#FFaaaaaa"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="👁" Style="{StaticResource IconButton}" Margin="0,0,10,0"/>
                                <Button Content="📋" Style="{StaticResource IconButton}"/>
                            </StackPanel>
                        </Grid>
                    </ListBoxItem>
                </ListBox>

                <!-- Add New Password Button -->
                <Button Content="+ Add New Password" 
                        Style="{StaticResource IconButton}"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Left"
                        Padding="10,5"
                        Background="#FF4a4a8a"
                        Click="AddNewPassword_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
