<Page x:Class="password_manager.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:password_manager"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">

    <Page.Resources>
        <!-- Gradient Brushes -->
        <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF1a1a2e" Offset="0"/>
            <GradientStop Color="#FF16213e" Offset="1"/>
        </LinearGradientBrush>

        <!-- TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#FF2a2a4a"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            BorderThickness="2"
                            BorderBrush="#FF3a3a5a">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PasswordBox Style -->
        <Style x:Key="ModernPasswordBox" TargetType="{x:Type PasswordBox}">
            <Setter Property="Background" Value="#FF2a2a4a"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            BorderThickness="2"
                            BorderBrush="#FF3a3a5a">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Style -->
        <Style x:Key="GlowButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FF4a4a8a"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" 
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF5a5a9a" TargetName="border"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF6a6aaa" BlurRadius="15" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Border CornerRadius="20" Background="{StaticResource BackgroundGradient}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="-90" RenderingBias="Quality" ShadowDepth="2"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Window Chrome -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
                <Button x:Name="CloseButton" 
                    Content="✕" 
                    Click="CloseButton_Click"
                    HorizontalAlignment="Right" 
                    Width="30" 
                    Height="30"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#FFaaaaaa"/>
            </Grid>

            <!-- Main Content -->
            <StackPanel Grid.Row="1" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Width="300">

                <!-- Logo/Title -->
                <TextBlock Text="🔐" 
                     FontSize="48" 
                     HorizontalAlignment="Center"
                     Margin="0,0,0,10"/>
                <TextBlock Text="Password Manager" 
                     FontSize="24" 
                     FontWeight="Bold" 
                     Foreground="White"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,40"/>

                <!-- Login Form -->
                <TextBlock Text="Username" 
                     Foreground="#FFaaaaaa" 
                     Margin="0,0,0,8"
                     FontSize="14"/>
                <TextBox x:Name="UsernameTextBox" 
                    Style="{StaticResource ModernTextBox}"
                    Margin="0,0,0,20"/>

                <TextBlock Text="Email" 
                     Foreground="#FFaaaaaa" 
                     Margin="0,0,0,8"
                     FontSize="14"/>
                <TextBox x:Name="EmailTextBox" 
                       Style="{StaticResource ModernTextBox}"
                       Margin="0,0,0,30"/>

                <!-- Buttons -->
                <Button Content="Login" 
                    Style="{StaticResource GlowButton}"
                    Click="LoginButton_Click"
                    Margin="0,0,0,15"/>

                <Button Content="Sign Up" 
                    Style="{StaticResource GlowButton}"
                    Click="SignupButton_Click"
                    Background="#FF2a2a4a"/>

                <!-- Additional Links -->
                <TextBlock Text="Forgot Password?" 
                     Foreground="#FFaaaaaa"
                     HorizontalAlignment="Center"
                     Margin="0,20,0,0"
                     Cursor="Hand"/>

                <Frame x:Name="myFrame" />
            </StackPanel>
        </Grid>
    </Border>
</Page>
