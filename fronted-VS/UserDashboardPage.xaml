<Page x:Class="password_manager.UserDashboardPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:password_manager"
        mc:Ignorable="d"
        Title="Password Manager Dashboard" 
        Background="Transparent">

    <Page.Resources>
        <!-- Gradient Brushes -->
        <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF1a1a2e" Offset="0"/>
            <GradientStop Color="#FF16213e" Offset="1"/>
        </LinearGradientBrush>

        <!-- ListBox Item Style -->
        <Style x:Key="PasswordListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="#FF2a2a4a"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="8">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Style -->
        <Style x:Key="IconButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFaaaaaa"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Border CornerRadius="20" Background="{StaticResource BackgroundGradient}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="-90" RenderingBias="Quality" ShadowDepth="2"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Window Chrome -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinimizeButton" 
                            Content="−" 
                            Click="MinimizeButton_Click"
                            Width="30" 
                            Height="30"
                            Style="{StaticResource IconButton}"/>
                    <Button x:Name="MaximizeButton" 
                            Content="□" 
                            Click="MaximizeButton_Click"
                            Width="30" 
                            Height="30"
                            Style="{StaticResource IconButton}"/>
                    <Button x:Name="CloseButton" 
                            Content="✕" 
                            Click="CloseButton_Click"
                            Width="30" 
                            Height="30"
                            Style="{StaticResource IconButton}"/>
                </StackPanel>
            </Grid>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🔐 Password Manager" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="White"
                               Margin="0,0,0,30"/>

                    <!-- <Button Content="📁 All Passwords" 
                            Foreground="White"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Left"
                            Click="GetAllPasswordsPage"
                            Margin="0,0,0,10"/> -->

                    <Button Content="🔒 Private Passwords" 
                            Foreground="White"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Left"
                            Click="GetPrivatePasswordsPage"
                            Margin="0,0,0,10"/>

                    <Button Content="👥 Groups" 
                        Foreground="White"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,10"
                        Click="GetUserGroupsPage"/>

                    <Button Content="📜 Passwords History" 
                        Foreground="White"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,10"
                        Click="GetHistoryPage"/>
                </StackPanel>

                <!-- Main Content Area -->
                <Grid Grid.Column="1" Margin="20,0,0,0">
                   
                    <Frame x:Name="myFrame"/>

                    <Image x:Name="BackgroundImage" 
                       Source="/Logo/Photo_logo.jpg" 
                       Stretch="UniformToFill" 
                       Opacity="0.20" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Page>