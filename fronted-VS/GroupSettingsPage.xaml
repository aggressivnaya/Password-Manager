<Page x:Class="password_manager.GroupSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:password_manager"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GroupSettingsPage">

    <Page.Resources>
        <!-- Gradient Brushes -->
        <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF1a1a2e" Offset="0"/>
            <GradientStop Color="#FF16213e" Offset="1"/>
        </LinearGradientBrush>

        <!-- ListBox Item Style -->
        <Style x:Key="UserListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="#FF2a2a4a"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="8">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Style -->
        <Style x:Key="ModernButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FF4a4a8a"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF5a5a9a"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#FF8a4a4a"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF9a5a5a"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Icon Button Style -->
        <Style x:Key="IconButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFaaaaaa"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource BackgroundGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <TextBlock x:Name="GroupNameText" Text="Group Settings" FontSize="24" FontWeight="Bold" Foreground="White" Margin="20,20,20,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,20,0">
                <Button x:Name="BackButton" Content="⬅️" Width="30" Height="30" Style="{StaticResource IconButton}" Click="BackButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Group Info -->
        <StackPanel Grid.Row="1" Margin="20,0,20,20">
            <TextBlock x:Name="GroupRoleText" Text="Your Role: Member" Foreground="#FFaaaaaa" Margin="0,0,0,5"/>
            <TextBlock x:Name="GroupMembersText" Text="0 members • 0 passwords" Foreground="#FFaaaaaa"/>
        </StackPanel>

        <!-- Members List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="20,0,20,20">
            <StackPanel>
                <TextBlock Text="Group Members" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                <ListBox x:Name="MembersListBox" 
                         Background="Transparent" 
                         BorderThickness="0" 
                         ItemContainerStyle="{StaticResource UserListBoxItem}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Leave Group Button -->
        <Button Grid.Row="3" Content="Leave Group" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Margin="20,0,20,20" Click="LeaveGroup_Click"/>
    </Grid>
</Page>